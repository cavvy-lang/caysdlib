// ============================================================
// test_caysdlib - Cavvy SDL2 Test Program
// Demonstrates caysdlib binding library: window, renderer, events
// ============================================================
#include <caysdlib/lib.cay>

public class main {
    public static void main() {
        println("Starting Cavvy SDL2 Test...");

        // === Initialize SDL ===
        if (SDL.init(SDL_INIT_VIDEO) < 0) {
            println("SDL_Init failed: " + SDL.getError());
            return;
        }

        // === Create Window ===
        Window window = new Window(
            "Cavvy SDL2 Test - Press ESC to quit",
            SDL_WINDOWPOS_CENTERED,
            SDL_WINDOWPOS_CENTERED,
            800, 600,
            SDL_WINDOW_SHOWN
        );
        if (!window.isValid()) {
            println("Window creation failed: " + SDL.getError());
            SDL.quit();
            return;
        }

        // === Create Renderer ===
        Renderer renderer = new Renderer(window.getHandle(), -1, SDL_RENDERER_ACCELERATED);
        if (!renderer.isValid()) {
            println("Renderer creation failed: " + SDL.getError());
            window.destroy();
            SDL.quit();
            return;
        }

        // === Main Loop ===
        Event event = new Event();
        boolean running = true;
        int frameCount = 0;
        int startTime = SDL.getTicks();

        // Animated rectangle position
        int rectX = 50;
        int rectY = 50;
        int rectDirX = 1;
        int rectDirY = 1;

        while (running) {
            // === Event Handling ===
            while (event.poll() != 0) {
                int eventType = event.getType();

                if (eventType == SDL_QUIT) {
                    running = false;
                } else if (eventType == SDL_KEYDOWN) {
                    int scancode = event.getKeyScancode();
                    if (scancode == SDL_SCANCODE_ESCAPE) {
                        running = false;
                    }
                }
            }

            // === Animation ===
            rectX = rectX + rectDirX * 3;
            rectY = rectY + rectDirY * 2;

            if (rectX <= 0 || rectX >= 700) {
                rectDirX = -rectDirX;
            }
            if (rectY <= 0 || rectY >= 500) {
                rectDirY = -rectDirY;
            }

            // === Rendering ===
            // Clear with dark blue background
            renderer.setDrawColor(10, 10, 40, 255);
            renderer.clear();

            // === Draw a moving red rectangle ===
            Rect movingRect = new Rect(rectX, rectY, 100, 80);
            renderer.setDrawColor(220, 50, 50, 255);
            renderer.fillRect(movingRect.getPtr());
            movingRect.dispose();

            // === Draw a green border around the moving rect ===
            Rect borderRect = new Rect(rectX - 2, rectY - 2, 104, 84);
            renderer.setDrawColor(50, 255, 50, 255);
            renderer.drawRect(borderRect.getPtr());
            borderRect.dispose();

            // === Draw some cyan lines (cross) ===
            renderer.setDrawColor(0, 200, 200, 255);
            renderer.drawLine(400, 300, rectX + 50, rectY + 40);
            renderer.drawLine(rectX + 50, 300, 400, rectY + 40);

            // === Draw yellow points at random positions ===
            renderer.setDrawColor(255, 255, 0, 255);
            for (int i = 0; i < 20; i = i + 1) {
                int px = (frameCount * 7 + i * 31) % 800;
                int py = (frameCount * 13 + i * 47) % 600;
                renderer.drawPoint(px, py);
            }

            // === Draw a white frame around the window ===
            Rect windowFrame = new Rect(0, 0, 799, 599);
            renderer.setDrawColor(255, 255, 255, 255);
            renderer.drawRect(windowFrame.getPtr());
            windowFrame.dispose();

            // === Present the frame ===
            renderer.present();

            // === Frame rate control ===
            SDL.delay(16);
            frameCount = frameCount + 1;
        }

        // === Performance Stats ===
        int elapsed = SDL.getTicks() - startTime;
        if (elapsed > 0) {
            int fps = frameCount * 1000 / elapsed;
            println("Rendered " + frameCount + " frames in " + elapsed + " ms (" + fps + " FPS)");
        }

        // === Cleanup ===
        event.dispose();
        renderer.destroy();
        window.destroy();
        SDL.quit();

        println("SDL2 Test completed successfully!");
    }
}
